{
  "name": "securescan",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "test": "jest --watchAll=false --passWithNoTests",
    "test:coverage": "jest --coverage --passWithNoTests",
    "build:preview": "eas build --platform all --profile preview",
    "build:ios": "eas build --platform ios --profile production",
    "build:android": "eas build --platform android --profile production",
    "submit:ios": "eas submit --platform ios --profile production",
    "submit:android": "eas submit --platform android --profile production",
    "submit:all": "eas submit --platform all --profile production",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "expo": "~51.0.0",
    "expo-status-bar": "~1.12.1",
    "expo-secure-store": "~13.0.1",
    "expo-local-authentication": "~14.0.1",
    "expo-notifications": "~0.28.3",
    "expo-linking": "~6.3.1",
    "expo-constants": "~16.0.2",
    "expo-splash-screen": "~0.27.5",
    "expo-sharing": "~12.0.1",
    "expo-file-system": "~17.0.1",
    "expo-haptics": "~13.0.1",
    "expo-web-browser": "~13.0.3",
    "expo-build-properties": "~0.12.3",
    "expo-tracking-transparency": "~4.0.2",
    "react": "18.2.0",
    "react-native": "0.74.1",
    "react-native-safe-area-context": "4.10.1",
    "react-native-screens": "3.31.1",
    "react-native-gesture-handler": "~2.16.1",
    "react-native-reanimated": "~3.10.1",
    "react-native-svg": "15.2.0",
    "@react-navigation/native": "^6.1.17",
    "@react-navigation/bottom-tabs": "^6.5.20",
    "@react-navigation/native-stack": "^6.9.26",
    "@supabase/supabase-js": "^2.43.4",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-purchases": "^7.27.0",
    "react-native-share": "^10.1.1",
    "date-fns": "^3.6.0",
    "@react-native-async-storage/async-storage": "1.23.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/react": "~18.2.45",
    "@types/react-native": "^0.73.0",
    "typescript": "^5.3.0",
    "jest": "^29.7.0",
    "@testing-library/react-native": "^12.5.1",
    "@testing-library/jest-native": "^5.4.3",
    "jest-expo": "~51.0.3",
    "react-test-renderer": "18.2.0",
    "@types/jest": "^29.5.12"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|react-navigation|@react-navigation/.*|react-native-purchases|react-native-reanimated)"
    ],
    "moduleNameMapper": {
      "^expo-constants$": "<rootDir>/__mocks__/expo-constants.js",
      "^expo-secure-store$": "<rootDir>/__mocks__/expo-secure-store.js",
      "^expo-local-authentication$": "<rootDir>/__mocks__/expo-local-authentication.js",
      "^expo-notifications$": "<rootDir>/__mocks__/expo-notifications.js",
      "^expo-haptics$": "<rootDir>/__mocks__/expo-haptics.js",
      "^expo-linking$": "<rootDir>/__mocks__/expo-linking.js",
      "^expo-splash-screen$": "<rootDir>/__mocks__/expo-splash-screen.js",
      "^react-native-purchases$": "<rootDir>/__mocks__/react-native-purchases.js",
      "^@supabase/supabase-js$": "<rootDir>/__mocks__/supabase.js",
      "^react-native-url-polyfill/auto$": "<rootDir>/__mocks__/url-polyfill.js"
    },
    "collectCoverageFrom": ["src/**/*.{ts,tsx}", "!src/**/*.d.ts"]
  },
  "private": true
}
